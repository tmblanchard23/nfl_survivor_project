# Secrets -- never commit this. It's a private key for your Google service
# account. If it's already been pushed anywhere, treat it as compromised:
# delete the key in Google Cloud Console and generate a new one.
service_account.json
 
# Your personal settings (has your real sheet URL / credentials path in it).
# Commit config.example.toml instead -- see note below.
config.toml
 
# Saved Python-API state, if you ever use that path instead of the sheet.
pool_state.pkl
*.pkl

#Odds API Scraper Script (Google Sheets.gs)
odds_api_scraper.gs
 
# Python build/cache artifacts.
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
 
# Editor/OS noise.
.DS_Store
.vscode/
.idea/
 
# Any report files you save locally with --save.
*.md
!README.md